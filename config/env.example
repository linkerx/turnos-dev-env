# Turnos Development Environment Configuration
# Copy this file to .env and adjust values as needed

# API Configuration
API_PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=turnos_db
DB_SYNC=true
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-NEVER-commit-this
JWT_EXPIRES_IN=7d

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@turnos.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
